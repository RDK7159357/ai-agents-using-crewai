# AI Agent Briefer - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED: Web Search
# ============================================
SERPER_API_KEY=your_serper_api_key_here
# Get free key at: https://serper.dev/

# ============================================
# REQUIRED: Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get from @BotFather on Telegram

TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Send a message to your bot, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates

# ============================================
# REQUIRED: LLM Provider (FREE TIER ONLY)
# ============================================

# Google Gemini API Key (FREE - REQUIRED)
GOOGLE_API_KEY=your_google_api_key_here
# Get free key at: https://aistudio.google.com/app/apikey
#
# Free tier options:
# - Gemini 1.5 Flash: 1,500 requests/day (default, recommended)
# - Gemini 2.5 Flash: 20 requests/day (set PREFERRED_MODEL=gemini-2.5)
#
# This is the ONLY required API key - 100% FREE!

# ============================================
# OPTIONAL: Additional Free-Tier Providers
# (Use any of these as fallbacks)
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
#
# Get keys here:
# Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
# Mistral: https://console.mistral.ai/api-keys

# ============================================
# OPTIONAL: Model Selection (FREE TIER ONLY)
# ============================================
# PREFERRED_MODEL=gemini
# Options: gemini, gemini-2.5, groq, openrouter, mistral
# gemini (1.5 Flash - 1500/day), gemini-2.5 (2.5 Flash - 20/day)
# If not set, defaults to gemini (1.5 Flash with 1500 req/day)
# Both options are FREE - no paid models used

# ============================================
# OPTIONAL: Text-to-Speech
# ============================================
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Get free key at: https://elevenlabs.io/
# Free tier: 10,000 characters/month
# Comment out if you don't want voice output

# ============================================
# OPTIONAL: GitHub Integration (for webhook mode)
# ============================================
# GITHUB_TOKEN=ghp_your_github_token_here
# GITHUB_REPO=username/repo-name
# Only needed if using GitHub Actions webhook mode

# ============================================
# TIPS
# ============================================
# 1. Start with just GOOGLE_API_KEY (free, 1500 req/day)
# 2. Add GROQ_API_KEY / OPENROUTER_API_KEY / MISTRAL_API_KEY as backup
# 3. App automatically falls back if primary model fails
# 4. Each daily brief uses ~5-15 API requests
# 5. Monitor usage at the respective provider dashboards
